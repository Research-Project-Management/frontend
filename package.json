{
  "name": "rpm",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "next dev --turbopack --port 2915",
    "dev:turbo": "next dev --turbopack --port 2915",
    "dev:webpack": "next dev --webpack --port 2915",
    "build": "next build --turbopack",
    "build:webpack": "next build --webpack",
    "start": "next start --port 2915",
    "clean:ports": "powershell -Command \"Get-NetTCPConnection -LocalPort 2915,3000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "clean": "node -e \"require('fs').rmSync('.next', {recursive:true,force:true});\" && echo cleaned",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "codebase:sync": "node ../.agents/scripts/sync-codebase.mjs frontend",
    "audit:dry": "npx --yes jscpd --threshold 5 -i \"**/*.json\" src",
    "audit:circular": "npx --yes madge --circular --extensions ts,tsx src",
    "audit:deadcode": "npx --yes knip",
    "audit:security": "pnpm audit",
    "audit:quality": "pnpm typecheck && pnpm audit:circular && pnpm audit:dry"
  },
