{
  "minTokens": 60,
  "minLines": 6,
  "mode": "mild",
  "format": ["typescript", "tsx"],
  "pattern": "src/**/*.{ts,tsx}",
  "ignore": ["**/*.spec.{ts,tsx}", "**/*.test.{ts,tsx}", "**/*.d.ts", ".next/**"],
  "ignorePattern": [
    "(?s)/\\* jscpd:ignore-start \\*/.*?/\\* jscpd:ignore-end \\*/"
  ],
  "reporters": ["console"],
  "threshold": 1.6,
  "noColors": true,
  "noTips": true
}
